# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Registry ───────────────────────────────────────────────────────────────────
REGISTRY_HOST=0.0.0.0
REGISTRY_PORT=8000
# Boş bırakılırsa API key kontrolü devre dışı kalır
REGISTRY_API_KEY=

# ── Agent ports ────────────────────────────────────────────────────────────────
DATA_AGENT_PORT=9001
SEARCH_AGENT_PORT=9002
ANALYSIS_AGENT_PORT=9003

# ── Orchestrator ───────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=8002
ORCHESTRATOR_MODEL=claude-sonnet-4-5

# ── No-Code Role Builder ───────────────────────────────────────────────────────
ROLE_BUILDER_PORT=8001

# ── Frontend (Next.js public vars) ────────────────────────────────────────────
NEXT_PUBLIC_REGISTRY_URL=http://localhost:8000
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8002
NEXT_PUBLIC_ROLE_BUILDER_URL=http://localhost:8001

# ── Database (optional — TF-IDF kullanılıyor, pgvector ileride) ───────────────
# DATABASE_URL=postgresql+asyncpg://mnacp:mnacp@localhost:5432/mnacp

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
